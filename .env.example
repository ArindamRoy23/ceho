# Sample local environment. Copy to `.env` (gitignored).
#
# COMPOSE_FILE lets `docker compose` and the devcontainer find the Compose
# file. devcontainer.json leaves dockerComposeFile empty so variable
# substitution uses this repo-root file.
COMPOSE_FILE=.devcontainer/docker-compose.yml
#
# PostgreSQL is included so local work has a SQL database. This choice is
# provisional and will be revisited after the design discussion.
# Vector store, cache, and queue settings are intentionally omitted.
#
# Inside the devcontainer, the database host is `postgres` on port 5432.
# From the host machine, the published port is localhost:5433
# (5433 avoids a Postgres already bound to 5432). Override the host port
# with POSTGRES_HOST_PORT when starting Compose.

DATABASE_URL=postgresql://ceho:ceho@postgres:5432/ceho
# DATABASE_URL=postgresql://ceho:ceho@localhost:5433/ceho
POSTGRES_USER=ceho
POSTGRES_PASSWORD=ceho
POSTGRES_DB=ceho
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# MinIO is the local S3-compatible store for media objects. The API host
# inside Compose is `minio` on port 9000. From the host machine the published
# ports are localhost:9000 (API) and localhost:9001 (console). Cloud
# deployment keeps CEHO_MEDIA_STORAGE_URI and unsets CEHO_S3_ENDPOINT_URL so
# the client uses the cloud S3 endpoint. Replace the key, secret, and region
# there. A set endpoint means path-style addressing, which MinIO requires.
# MINIO_ROOT_PASSWORD must stay URL-safe; bucket creation embeds it in MC_HOST.
MINIO_ROOT_USER=ceho
MINIO_ROOT_PASSWORD=ceho-dev-only
MINIO_BUCKET=ceho-media
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Hot-server runtime configuration. The publisher URL is a development
# placeholder; this stack does not publish events yet.
CEHO_MEDIA_STORAGE_URI=s3://ceho-media
CEHO_S3_ENDPOINT_URL=http://minio:9000
# CEHO_S3_ENDPOINT_URL=http://localhost:9000
CEHO_S3_ACCESS_KEY_ID=ceho
CEHO_S3_SECRET_ACCESS_KEY=ceho-dev-only
CEHO_S3_REGION=us-east-1
CEHO_SIGNALING_SECRET=development-only-change-me
CEHO_EVENT_PUBLISHER_URL=memory://ceho
CEHO_HOST=0.0.0.0
CEHO_PORT=8000
